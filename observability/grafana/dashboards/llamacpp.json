{
  "uid": "llamacpp",
  "title": "llama.cpp",
  "tags": [
    "llamacpp",
    "inference"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput (tokens/s, server average)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:prompt_tokens_seconds",
          "legendFormat": "prompt"
        },
        {
          "refId": "B",
          "expr": "llamacpp:predicted_tokens_seconds",
          "legendFormat": "predicted"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue depth: requests processing / deferred",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:requests_processing",
          "legendFormat": "processing"
        },
        {
          "refId": "B",
          "expr": "llamacpp:requests_deferred",
          "legendFormat": "deferred"
        }
      ],
      "description": "deferred = requests waiting for a free slot (compose runs --parallel 2). This llama.cpp build (b11459) exposes no KV cache usage metric."
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Tokens/s (counter rate, 1m)",
      "description": "Rate of the token counters. Unlike the server-average gauges above, this drops to 0 when idle.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(llamacpp:prompt_tokens_total[1m])",
          "legendFormat": "prompt"
        },
        {
          "refId": "B",
          "expr": "rate(llamacpp:tokens_predicted_total[1m])",
          "legendFormat": "predicted"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Busy slots per decode",
      "description": "Average number of slots batched per decode call: 1 = no batching, 2 = both slots busy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "llamacpp:n_busy_slots_per_decode",
          "legendFormat": "slots"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scrape up per job",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
