# Local dev only. Copy to .env (git-ignored): cp .env.example .env
POSTGRES_PASSWORD=dev-postgres-change-me
ELASTIC_PASSWORD=dev-elastic-change-me
GRAFANA_ADMIN_PASSWORD=dev-grafana-change-me

# Langfuse (profile `langfuse`, off by default). Fill these, then: docker compose --profile langfuse up -d --wait
# Generate every value fresh (Git Bash or Linux):
#   for v in LANGFUSE_DB_PASSWORD LANGFUSE_CLICKHOUSE_PASSWORD LANGFUSE_REDIS_AUTH LANGFUSE_MINIO_PASSWORD \
#            LANGFUSE_SALT LANGFUSE_NEXTAUTH_SECRET LANGFUSE_INIT_USER_PASSWORD; do echo "$v=$(openssl rand -hex 16)"; done
#   echo "LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)"   # must be 64 hex chars
#   echo "LANGFUSE_PUBLIC_KEY=pk-lf-$(openssl rand -hex 16)"; echo "LANGFUSE_SECRET_KEY=sk-lf-$(openssl rand -hex 16)"
# Sending traces to Langfuse: set LANGFUSE_OTEL_ENDPOINT=http://langfuse-web:3000/api/public/otel and recreate
# otel-collector (docker compose up -d otel-collector). Empty (default) = traces go to Tempo only. Clear it again
# when the langfuse profile is stopped, or the collector logs export errors (Tempo is not affected).
LANGFUSE_OTEL_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_DB_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_PASSWORD=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=
